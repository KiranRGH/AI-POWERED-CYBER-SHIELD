APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/cyber_threat_db
SECRET_KEY=your-secret-key-here-min-32-chars-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@cyberthreat.io
FRONTEND_ORIGIN=http://localhost:5173
OTP_EXPIRE_MINUTES=10
MAX_OTP_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
GEOLOCATION_API_KEY=your-api-key
IP_REPUTATION_API_KEY=your-api-key
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
SIMULATION_MODE=true
